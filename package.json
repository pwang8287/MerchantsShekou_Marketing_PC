{
  "name": "cmsk-marketing-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src --ext .ts,.vue",
    "format": "prettier --write src",
    "test": "node tests/run.mjs",
    "export:mocks": "node scripts/export-channel-mocks.mjs"
  },
  "dependencies": {
    "vue": "3.4.38",
    "vue-router": "4.4.5",
    "pinia": "2.2.2",
    "element-plus": "2.8.4",
    "@element-plus/icons-vue": "2.3.1",
    "echarts": "5.5.1",
    "axios": "1.13.2"
  },
  "devDependencies": {
    "vite": "4.5.14",
    "@vitejs/plugin-vue": "4.6.2",
    "typescript": "5.4.5",
    "vue-tsc": "2.0.29",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.28.0",
    "@typescript-eslint/parser": "6.21.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "prettier": "3.3.3",
    "esbuild": "0.18.20"
  },
  "engines": {
    "node": ">=16.20.2"
  }
}
